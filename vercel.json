{
  "outputDirectory": "web",
  "buildCommand": "",
  "functions": {
    "api/ai.js": { "maxDuration": 300 }
  },
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "same-origin" }
    ] }
  ]
}
